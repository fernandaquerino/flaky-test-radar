{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "prisma/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "packages/**/*.test.ts",
    "apps/**/*.test.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
